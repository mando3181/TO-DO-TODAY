rules_version = '2';

// قواعد حماية بيانات مَسار
// انسخ هذا الملف كاملاً إلى: Firebase Console ← Firestore Database ← Rules ← Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ غيّر هذا البريد إلى بريد المدير المالي (مالك النظام) — بأحرف صغيرة
    function ownerEmail() { return 'cfo@example.com'; }

    // مستخدم سجّل الدخول وأكّد بريده
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == ownerEmail(); }

    // قائمة الدخول يحدّثها النظام تلقائياً من حساب المالك:
    //   emails = كل الموظفين المضافين في الهيكل التنظيمي
    //   admins = من يملك صلاحيات إدارية (الهيكل، الإعداد، الصلاحيات، الاستيراد، النسخ الاحتياطي)
    function access() { return get(/databases/$(database)/documents/setup/access).data; }
    function hasAccessDoc() { return exists(/databases/$(database)/documents/setup/access); }
    function isMember() { return signedIn() && hasAccessDoc() && myEmail() in access().emails; }
    function isAdmin() { return isOwner() || (isMember() && myEmail() in access().get('admins', [])); }
    function allowed() { return isOwner() || isMember(); }

    // بيانات إدارية: يقرؤها كل الموظفين، ويعدّلها أصحاب الصلاحيات الإدارية فقط
    function adminOnly(collection) {
      return collection in ['team', 'depts', 'lines', 'branches', 'bankAccts', 'cashBoxes', 'setup'];
    }

    match /setup/access {
      allow read: if allowed();
      allow write: if isOwner();
    }

    match /{collection}/{docId} {
      allow read: if allowed() && !(collection == 'setup' && docId == 'access');
      allow write: if allowed()
        && !(collection == 'setup' && docId == 'access')
        && (!adminOnly(collection) || isAdmin());
    }
  }
}
